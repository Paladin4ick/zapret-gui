import { ComboBox, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { AppTheme, AppButton, AppToggle, NavButton, WindowButton } from "theme.slint";

export component MainWindow inherits Window {
    title: "zapret GUI";
    icon: @image-url("../assets/tray/zapret-on-32.png");
    no-frame: true;
    resize-border-width: 6px;
    background: AppTheme.background;
    preferred-width: 440px;
    preferred-height: 408px;
    min-width: 420px;
    min-height: 390px;
    default-font-family: "Segoe UI";

    // Horizontal and vertical dimensions follow the window independently.
    // Font growth is deliberately capped so labels remain compact at very large sizes.
    private property <float> x-scale: min(max(root.width / 440px, 0.95), 2.0);
    private property <float> y-scale: min(max(root.height / 408px, 0.95), 2.0);
    private property <float> font-scale: min(max((root.x-scale + root.y-scale) / 2, 0.95), 1.55);
    private property <float> uniform-scale: min(root.x-scale, root.y-scale);
    default-font-size: 12px * root.font-scale;

    in property <bool> zapret_running: false;
    in property <string> gui_version: "0.1.0";
    in property <bool> busy: false;
    in property <bool> testing: false;
    in property <int> test_current: 0;
    in property <int> test_total: 0;
    in property <[string]> strategies;
    in-out property <string> selected_strategy: "";
    in-out property <bool> minimize_to_tray: true;
    in property <string> version_text: "Zapret не установлен";
    in property <string> update_text: "Проверка обновлений…";
    in property <string> error_text: "";
    in-out property <string> notice_text: "";
    in-out property <bool> notice_warning: false;
    in-out property <bool> window_maximized: false;
    in-out property <int> page: 0;

    in property <[string]> list_titles;
    in-out property <string> selected_list: "";
    in-out property <string> list_content: "";
    in property <bool> list_editable: false;

    in property <[string]> game_modes: ["Отключён", "TCP и UDP", "Только TCP", "Только UDP"];
    in-out property <string> game_mode: "Отключён";
    in-out property <string> game_tcp: "1024-65535";
    in-out property <string> game_udp: "1024-65535";
    in property <[string]> ipset_modes: ["Загруженный", "Без IPSet", "Любой IP"];
    in-out property <string> ipset_mode: "Загруженный";
    in-out property <bool> auto_update: true;
    in-out property <bool> auto_start_app: true;
    in-out property <bool> auto_start_zapret: false;
    in property <[string]> fake_files;
    in-out property <string> discord_fake: "";
    in-out property <string> game_fake: "";

    callback toggle_zapret();
    callback strategy_selected(string);
    callback auto_select();
    callback cancel_test();
    callback check_updates();
    callback minimize_changed(bool);
    callback list_selected(string);
    callback save_list(string);
    callback save_settings(string, string, string, string, bool, bool, bool, string, string);
    callback open_logs();
    callback minimize_window();
    callback toggle_maximize();
    callback quit_requested();

    frame := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: AppTheme.background;
        border-width: 1px;
        border-color: AppTheme.outline;
        VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            spacing: 0px;
            title-bar := Rectangle {
                height: 36px * root.uniform-scale;
                background: AppTheme.sidebar;
                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: AppTheme.border;
                }
                WindowMoveArea {
                    width: parent.width - 116px * root.uniform-scale;
                    height: parent.height;
                    TouchArea { double-clicked => { root.toggle_maximize(); } }
                }
                Image {
                    x: 11px * root.uniform-scale;
                    y: (parent.height - self.height) / 2;
                    width: 20px * root.uniform-scale;
                    height: 20px * root.uniform-scale;
                    source: @image-url("../assets/icons/app-mark.svg");
                    image-fit: contain;
                }
                Text {
                    x: 39px * root.uniform-scale;
                    width: parent.width - 160px * root.uniform-scale;
                    height: parent.height;
                    text: "zapret GUI";
                    color: AppTheme.text;
                    font-size: 11px * root.font-scale;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    x: parent.width - 114px * root.uniform-scale;
                    y: 3px * root.uniform-scale;
                    width: 114px * root.uniform-scale;
                    height: 30px * root.uniform-scale;
                    spacing: 0px;
                    WindowButton {
                        scale: root.uniform-scale;
                        icon: @image-url("../assets/icons/window-minimize.svg");
                        clicked => { root.minimize_window(); }
                    }
                    WindowButton {
                        scale: root.uniform-scale;
                        icon: root.window_maximized ? @image-url("../assets/icons/window-restore.svg") : @image-url("../assets/icons/window-maximize.svg");
                        clicked => { root.toggle_maximize(); }
                    }
                    WindowButton {
                        scale: root.uniform-scale;
                        danger: true;
                        icon: @image-url("../assets/icons/window-close.svg");
                        clicked => { root.close(); }
                    }
                }
            }
            HorizontalLayout {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                spacing: 0px;
        sidebar := Rectangle {
            width: 46px * root.uniform-scale;
            background: AppTheme.sidebar;
            VerticalLayout {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                padding-left: 7px * root.uniform-scale;
                padding-right: 7px * root.uniform-scale;
                padding-top: 11px * root.y-scale;
                padding-bottom: 10px * root.y-scale;
                alignment: start;
                spacing: 8px * root.y-scale;
                NavButton {
                    scale: root.uniform-scale; font-scale: root.font-scale;
                    icon: root.page == 0 ? @image-url("../assets/icons/nav-home-active.svg") : @image-url("../assets/icons/nav-home.svg");
                    hint: "Главная";
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }
                NavButton {
                    scale: root.uniform-scale; font-scale: root.font-scale;
                    icon: root.page == 1 ? @image-url("../assets/icons/nav-lists-active.svg") : @image-url("../assets/icons/nav-lists.svg");
                    hint: "Списки";
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
                NavButton {
                    scale: root.uniform-scale; font-scale: root.font-scale;
                    icon: root.page == 2 ? @image-url("../assets/icons/nav-settings-active.svg") : @image-url("../assets/icons/nav-settings.svg");
                    hint: "Настройки";
                    active: root.page == 2;
                    clicked => { root.page = 2; }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                Text {
                    text: "v" + root.gui_version;
                    color: AppTheme.secondary;
                    font-size: 9px * root.font-scale;
                    horizontal-alignment: center;
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            background: AppTheme.background;
            if root.page == 0: home := VerticalLayout {
                padding: 18px * root.uniform-scale;
                spacing: 12px * root.y-scale;
                Text { text: "Главная"; color: AppTheme.text; font-size: 20px * root.font-scale; font-weight: 600; }
                Rectangle {
                    height: 100px * root.y-scale;
                    border-radius: 6px * root.uniform-scale;
                    background: root.zapret_running ? AppTheme.selected : AppTheme.surface;
                    border-width: 1px;
                    border-color: root.zapret_running ? AppTheme.accent : AppTheme.border;
                    animate background { duration: 180ms; }
                    animate border-color { duration: 180ms; }
                    Rectangle {
                        x: 7px * root.uniform-scale;
                        y: 16px * root.y-scale;
                        width: 3px * root.uniform-scale;
                        height: parent.height - 32px * root.y-scale;
                        border-radius: 2px * root.uniform-scale;
                        background: root.zapret_running ? AppTheme.accent-hover : AppTheme.inactive-icon;
                    }
                    HorizontalLayout {
                        padding: 16px * root.uniform-scale;
                        spacing: 18px * root.x-scale;
                        alignment: center;
                        power := Rectangle {
                            width: 68px * root.uniform-scale;
                            height: 68px * root.uniform-scale;
                            border-radius: 34px * root.uniform-scale;
                            background: root.zapret_running ? AppTheme.accent : AppTheme.inactive;
                            animate background { duration: 180ms; }
                            Image {
                                width: 26px * root.uniform-scale; height: 26px * root.uniform-scale;
                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                source: root.zapret_running ? @image-url("../assets/icons/power-on.svg") : @image-url("../assets/icons/power-off.svg");
                            }
                            TouchArea { enabled: !root.busy && !root.testing; clicked => { root.toggle_zapret(); } }
                        }
                        Text {
                            text: root.busy ? "Выполняется операция…" : root.zapret_running ? "Zapret включён" : "Zapret выключен";
                            color: AppTheme.text;
                            font-size: 15px * root.font-scale;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 116px * root.y-scale;
                    border-radius: 6px * root.uniform-scale;
                    background: AppTheme.surface;
                    border-width: 1px;
                    border-color: AppTheme.border;
                    VerticalLayout {
                        padding: 12px * root.uniform-scale;
                        spacing: 8px * root.y-scale;
                        Text { text: "Стратегия"; color: AppTheme.secondary; font-size: 10px * root.font-scale; }
                        HorizontalLayout {
                            height: 34px * root.y-scale; spacing: 8px * root.x-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.strategies;
                                current-value <=> root.selected_strategy;
                                enabled: !root.busy && !root.testing;
                                selected(value) => { root.strategy_selected(value); }
                            }
                            AppButton {
                                width: 142px * root.x-scale;
                                x-scale: root.x-scale; y-scale: root.y-scale; font-scale: root.font-scale;
                                text: root.testing ? "Проверка " + root.test_current + "/" + root.test_total : "Автоподбор стратегии";
                                enabled: !root.busy;
                                accent: root.testing;
                                clicked => { root.testing ? root.cancel_test() : root.auto_select(); }
                            }
                        }
                        Rectangle { height: 1px; background: AppTheme.border; }
                        HorizontalLayout {
                            height: 27px * root.y-scale;
                            VerticalLayout {
                                spacing: 1px * root.y-scale;
                                Text { text: root.version_text; color: AppTheme.text; font-size: 10px * root.font-scale; }
                                Text { text: root.update_text; color: AppTheme.secondary; font-size: 9px * root.font-scale; }
                            }
                            AppButton {
                                width: 86px * root.x-scale; height: 27px * root.y-scale; text: "Проверить";
                                x-scale: root.x-scale; y-scale: root.y-scale; font-scale: root.font-scale;
                                enabled: !root.busy && !root.testing;
                                clicked => { root.check_updates(); }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    height: 24px * root.y-scale;
                    Text { text: "Сворачивать в трей"; color: AppTheme.text; font-size: 11px * root.font-scale; vertical-alignment: center; }
                    AppToggle { scale: root.uniform-scale; checked <=> root.minimize_to_tray; toggled(value) => { root.minimize_changed(value); } }
                }
                if root.error_text != "": Text {
                    text: root.error_text; color: AppTheme.accent-hover; font-size: 10px * root.font-scale;
                    overflow: elide; horizontal-alignment: center;
                }
            }

            if root.page == 1: lists-page := VerticalLayout {
                padding: 18px * root.uniform-scale; spacing: 10px * root.y-scale;
                Text { text: "Списки"; color: AppTheme.text; font-size: 20px * root.font-scale; font-weight: 600; }
                Rectangle {
                    height: 34px * root.y-scale;
                    background: transparent;
                    ComboBox {
                        x: 4px * root.x-scale;
                        width: parent.width - 4px * root.x-scale;
                        height: parent.height;
                        model: root.list_titles;
                        current-value <=> root.selected_list;
                        selected(value) => { root.list_selected(value); }
                    }
                }
                Rectangle {
                    vertical-stretch: 1; border-radius: 6px * root.uniform-scale; background: AppTheme.background;
                    border-width: 1px; border-color: AppTheme.border;
                    TextEdit {
                        x: 8px * root.x-scale; y: 8px * root.y-scale;
                        width: parent.width - 16px * root.x-scale; height: parent.height - 16px * root.y-scale;
                        text <=> root.list_content; read-only: !root.list_editable;
                    }
                }
                HorizontalLayout {
                    height: 34px * root.y-scale;
                    Text {
                        text: root.list_editable ? "Пользовательский список" : "Системный список — только чтение";
                        color: AppTheme.secondary; font-size: 10px * root.font-scale; vertical-alignment: center;
                    }
                    AppButton {
                        width: 96px * root.x-scale; text: "Сохранить"; accent: true; enabled: root.list_editable;
                        x-scale: root.x-scale; y-scale: root.y-scale; font-scale: root.font-scale;
                        clicked => { root.save_list(root.list_content); }
                    }
                }
            }

            if root.page == 2: settings-page := ScrollView {
                VerticalLayout {
                    padding: 18px * root.uniform-scale; spacing: 10px * root.y-scale;
                    Text { text: "Настройки"; color: AppTheme.text; font-size: 20px * root.font-scale; font-weight: 600; }
                    Rectangle {
                        height: 224px * root.y-scale; border-radius: 6px * root.uniform-scale; background: AppTheme.surface;
                        border-width: 1px; border-color: AppTheme.border;
                        VerticalLayout {
                            padding: 12px * root.uniform-scale; spacing: 8px * root.y-scale;
                            Text { text: "Игровой фильтр"; color: AppTheme.text; font-size: 12px * root.font-scale; font-weight: 600; }
                            ComboBox { height: 32px * root.y-scale; model: root.game_modes; current-value <=> root.game_mode; }
                            HorizontalLayout {
                                height: 32px * root.y-scale; spacing: 10px * root.x-scale;
                                Text { width: 92px * root.x-scale; text: "TCP-порты"; color: AppTheme.secondary; font-size: 10px * root.font-scale; vertical-alignment: center; }
                                LineEdit { text <=> root.game_tcp; }
                            }
                            HorizontalLayout {
                                height: 32px * root.y-scale; spacing: 10px * root.x-scale;
                                Text { width: 92px * root.x-scale; text: "UDP-порты"; color: AppTheme.secondary; font-size: 10px * root.font-scale; vertical-alignment: center; }
                                LineEdit { text <=> root.game_udp; }
                            }
                            Text { text: "Режим IPSet"; color: AppTheme.text; font-size: 11px * root.font-scale; }
                            ComboBox { height: 32px * root.y-scale; model: root.ipset_modes; current-value <=> root.ipset_mode; }
                        }
                    }
                    Rectangle {
                        height: 108px * root.y-scale; border-radius: 6px * root.uniform-scale; background: AppTheme.surface;
                        border-width: 1px; border-color: AppTheme.border;
                        VerticalLayout {
                            padding: 10px * root.uniform-scale; spacing: 8px * root.y-scale;
                            HorizontalLayout {
                                height: 24px * root.y-scale;
                                Text { text: "Проверять обновления при запуске"; color: AppTheme.text; font-size: 10px * root.font-scale; vertical-alignment: center; }
                                AppToggle { scale: root.uniform-scale; checked <=> root.auto_update; }
                            }
                            HorizontalLayout {
                                height: 24px * root.y-scale;
                                Text { text: "Автозапуск приложения с Windows"; color: AppTheme.text; font-size: 10px * root.font-scale; vertical-alignment: center; }
                                AppToggle { scale: root.uniform-scale; checked <=> root.auto_start_app; }
                            }
                            HorizontalLayout {
                                height: 24px * root.y-scale;
                                Text {
                                    text: "Включать zapret при автозапуске";
                                    color: root.auto_start_app ? AppTheme.text : AppTheme.secondary;
                                    font-size: 10px * root.font-scale;
                                    vertical-alignment: center;
                                }
                                AppToggle {
                                    scale: root.uniform-scale;
                                    enabled: root.auto_start_app;
                                    checked <=> root.auto_start_zapret;
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 112px * root.y-scale; border-radius: 6px * root.uniform-scale; background: AppTheme.surface;
                        border-width: 1px; border-color: AppTheme.border;
                        VerticalLayout {
                            padding: 10px * root.uniform-scale; spacing: 7px * root.y-scale;
                            Text { text: "Активные fake-файлы"; color: AppTheme.text; font-size: 11px * root.font-scale; font-weight: 600; }
                            HorizontalLayout {
                                height: 32px * root.y-scale; spacing: 10px * root.x-scale;
                                Text { width: 92px * root.x-scale; text: "Discord UDP"; color: AppTheme.secondary; font-size: 10px * root.font-scale; vertical-alignment: center; }
                                ComboBox { height: 32px * root.y-scale; model: root.fake_files; current-value <=> root.discord_fake; }
                            }
                            HorizontalLayout {
                                height: 32px * root.y-scale; spacing: 10px * root.x-scale;
                                Text { width: 92px * root.x-scale; text: "GameFilter"; color: AppTheme.secondary; font-size: 10px * root.font-scale; vertical-alignment: center; }
                                ComboBox { height: 32px * root.y-scale; model: root.fake_files; current-value <=> root.game_fake; }
                            }
                        }
                    }
                    AppButton {
                        height: 36px * root.y-scale; text: "Сохранить настройки"; accent: true;
                        x-scale: root.x-scale; y-scale: root.y-scale; font-scale: root.font-scale;
                        clicked => { root.save_settings(root.game_mode, root.game_tcp, root.game_udp, root.ipset_mode, root.auto_update, root.auto_start_app, root.auto_start_zapret, root.discord_fake, root.game_fake); }
                    }
                    AppButton {
                        height: 32px * root.y-scale; text: "Открыть папку логов";
                        x-scale: root.x-scale; y-scale: root.y-scale; font-scale: root.font-scale;
                        clicked => { root.open_logs(); }
                    }
                }
            }
        }
    }
        }
    }

    Timer {
        interval: 3600ms;
        running: root.notice_text != "";
        triggered => { root.notice_text = ""; }
    }

    if root.notice_text != "": notice := Rectangle {
        x: root.width - self.width - 16px * root.uniform-scale;
        y: 48px * root.uniform-scale;
        width: 300px * root.uniform-scale;
        height: 48px * root.uniform-scale;
        border-radius: 6px * root.uniform-scale;
        background: root.notice_warning ? AppTheme.selected : AppTheme.surface;
        border-width: 1px;
        border-color: root.notice_warning ? AppTheme.accent-hover : AppTheme.success;
        z: 200;
        Rectangle {
            width: 4px * root.uniform-scale;
            height: parent.height - 12px * root.uniform-scale;
            x: 6px * root.uniform-scale;
            y: 6px * root.uniform-scale;
            border-radius: 2px * root.uniform-scale;
            background: root.notice_warning ? AppTheme.accent-hover : AppTheme.success;
        }
        Text {
            x: 20px * root.uniform-scale;
            width: parent.width - 32px * root.uniform-scale;
            height: parent.height;
            text: root.notice_text;
            color: AppTheme.text;
            font-size: 10px * root.font-scale;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        TouchArea { clicked => { root.notice_text = ""; } }
    }
}
